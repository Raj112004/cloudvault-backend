<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CloudVault Workspace</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <style>
    body {
      background-color: #0a0b0e;
      color: #e2e8f0;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    }
  </style>
</head>
<body class="min-h-screen">

  <div id="app" class="mx-auto max-w-[1440px] px-5 pb-10 pt-8 lg:px-8">
    <input type="file" id="file-input" class="hidden" multiple />

    <!-- DASHBOARD VIEW -->
    <div id="dashboard-view">
      <div class="mb-8 flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
        <div>
          <div class="mb-2 flex items-center gap-2 text-[11px] font-medium uppercase tracking-[0.16em] text-indigo-300">
            <span class="h-1.5 w-1.5 rounded-full bg-cyan-300 shadow-[0_0_10px_#22d3ee]"></span>
            Live workspace
          </div>
          <h1 class="text-[28px] font-semibold tracking-[-0.04em] text-white">
            CloudVault Storage <span class="text-xl">✦</span>
          </h1>
          <p class="mt-1.5 text-[13px] text-slate-500">Connected to Backblaze B2.</p>
        </div>

        <div class="flex gap-2">
          <button id="btn-upload" class="flex items-center gap-2 rounded-lg bg-indigo-500 px-4 py-2.5 text-[12px] font-semibold text-white shadow-[0_8px_24px_rgba(99,102,241,0.22)] transition hover:bg-indigo-400">
            <i data-lucide="upload-cloud" class="w-4 h-4"></i>
            Upload File
          </button>
        </div>
      </div>

      <!-- Live Analytics Cards -->
      <div class="mb-8 grid gap-4 xl:grid-cols-[1.35fr_1fr_1fr]">
        <div class="relative overflow-hidden rounded-2xl border border-white/[0.08] bg-gradient-to-br from-indigo-500/[0.16] via-[#171828] to-cyan-400/[0.06] p-5">
          <div class="relative flex items-center gap-5">
            <div class="relative h-28 w-28 shrink-0">
              <svg class="h-28 w-28 -rotate-90" viewBox="0 0 44 44" fill="none">
                <circle cx="22" cy="22" r="17" stroke="rgba(255,255,255,0.08)" stroke-width="3.5" />
                <circle id="storage-ring-circle" cx="22" cy="22" r="17" stroke="url(#usage)" stroke-width="3.5" stroke-linecap="round" stroke-dasharray="106.8" stroke-dashoffset="106.8" />
                <defs>
                  <linearGradient id="usage" x1="5" y1="8" x2="38" y2="36">
                    <stop stop-color="#818cf8" />
                    <stop offset="1" stop-color="#22d3ee" />
                  </linearGradient>
                </defs>
              </svg>
              <div class="absolute inset-0 flex flex-col items-center justify-center">
                <span id="storage-pct-label" class="text-xl font-semibold tracking-tight text-white">0%</span>
                <span class="text-[9px] uppercase tracking-[0.16em] text-slate-500">used</span>
              </div>
            </div>
            <div>
              <div class="mb-1 text-[11px] font-medium text-slate-400">Storage overview</div>
              <div class="text-[21px] font-semibold tracking-[-0.03em] text-white">
                <span id="storage-used-gb">0.00</span> <span class="text-sm font-normal text-slate-500">/ 10 GB</span>
              </div>
              <div class="mt-1.5 flex items-center gap-1.5 text-[11px] text-cyan-300">
                <i data-lucide="arrow-down-to-line" class="w-3 h-3"></i>
                <span id="storage-bytes-count">0 MB active</span>
              </div>
            </div>
          </div>
          <div class="relative mt-5 flex gap-4 border-t border-white/[0.08] pt-4 text-[10px] text-slate-500">
            <span><i class="mr-1.5 inline-block h-1.5 w-1.5 rounded-full bg-indigo-400"></i>Media: <span id="stat-media-size" class="text-slate-300">0 MB</span></span>
            <span><i class="mr-1.5 inline-block h-1.5 w-1.5 rounded-full bg-cyan-300"></i>Docs: <span id="stat-docs-size" class="text-slate-300">0 MB</span></span>
          </div>
        </div>

        <div class="rounded-2xl border border-white/[0.08] bg-white/[0.025] p-5">
          <div class="mb-5 flex items-center justify-between">
            <span class="text-[11px] font-medium text-slate-500">Total Files</span>
            <div class="flex h-7 w-7 items-center justify-center rounded-lg bg-cyan-400/10 text-cyan-300">
              <i data-lucide="hard-drive" class="w-3.5 h-3.5"></i>
            </div>
          </div>
          <div id="stat-total-files" class="text-[25px] font-semibold tracking-[-0.04em] text-white">
            0 <span class="text-sm font-normal text-slate-500">files indexed</span>
          </div>
          <div class="mt-3 flex items-center gap-2 text-[11px] text-emerald-300">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
            CloudVault Synced
          </div>
        </div>

        <div class="rounded-2xl border border-white/[0.08] bg-white/[0.025] p-5">
          <div class="mb-5 flex items-center justify-between">
            <span class="text-[11px] font-medium text-slate-500">Backend Status</span>
            <div class="flex h-7 w-7 items-center justify-center rounded-lg bg-indigo-400/10 text-indigo-300">
              <i data-lucide="zap" class="w-3.5 h-3.5"></i>
            </div>
          </div>
          <div class="text-[25px] font-semibold tracking-[-0.04em] text-white">
            Live <span class="text-sm font-normal text-slate-500">Streaming</span>
          </div>
          <div class="mt-3 flex items-center gap-2 text-[11px] text-slate-500">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
            B2 Direct Link Active
          </div>
        </div>
      </div>

      <!-- Filters -->
      <div class="mb-5 flex gap-2 overflow-x-auto pb-1" id="filter-container">
        <button class="filter-tab whitespace-nowrap rounded-full border px-3 py-1.5 text-[11px] border-indigo-400/30 bg-indigo-400/10 text-indigo-200" data-filter="All types">All types</button>
        <button class="filter-tab whitespace-nowrap rounded-full border border-white/[0.07] px-3 py-1.5 text-[11px] text-slate-600 hover:border-white/[0.14] hover:text-slate-300" data-filter="video">Video</button>
        <button class="filter-tab whitespace-nowrap rounded-full border border-white/[0.07] px-3 py-1.5 text-[11px] text-slate-600 hover:border-white/[0.14] hover:text-slate-300" data-filter="image">Image</button>
        <button class="filter-tab whitespace-nowrap rounded-full border border-white/[0.07] px-3 py-1.5 text-[11px] text-slate-600 hover:border-white/[0.14] hover:text-slate-300" data-filter="audio">Audio</button>
        <button class="filter-tab whitespace-nowrap rounded-full border border-white/[0.07] px-3 py-1.5 text-[11px] text-slate-600 hover:border-white/[0.14] hover:text-slate-300" data-filter="document">Document</button>
      </div>

      <!-- Live File List -->
      <div id="file-container" class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4"></div>
    </div>

    <!-- PREVIEW / STREAMING VIEW -->
    <div id="player-view" class="hidden">
      <div class="mb-6 flex items-center justify-between">
        <div>
          <button id="btn-back" class="mb-2 text-[12px] text-indigo-300 hover:text-indigo-200">← Back to dashboard</button>
          <h1 id="player-file-name" class="text-[22px] font-semibold tracking-[-0.04em] text-white">Media Preview</h1>
        </div>
        <a id="btn-download-file" href="#" target="_blank" download class="flex items-center gap-2 rounded-lg bg-white/[0.08] px-3.5 py-2 text-[11px] font-medium text-slate-200 hover:bg-white/[0.14]">
          <i data-lucide="download" class="w-3.5 h-3.5"></i> Download
        </a>
      </div>

      <div class="overflow-hidden rounded-2xl border border-white/[0.08] bg-black/50 p-4 flex items-center justify-center min-h-[400px]">
        <img id="vault-image-preview" class="max-h-[600px] max-w-full rounded-xl object-contain hidden" />
        <video id="vault-video-player" controls class="w-full max-h-[650px] rounded-xl hidden"></video>
        <audio id="vault-audio-player" controls class="w-full my-12 hidden"></audio>
        <div id="vault-doc-preview" class="hidden text-center p-8">
          <i data-lucide="file-text" class="w-16 h-16 mx-auto mb-3 text-indigo-400"></i>
          <p class="text-sm text-slate-300 mb-4">Document preview not directly streamable.</p>
          <a id="vault-doc-link" href="#" target="_blank" class="rounded-lg bg-indigo-500 px-4 py-2 text-xs font-semibold text-white">Download / View File</a>
        </div>
      </div>
    </div>

    <!-- Upload Progress Toast -->
    <div id="upload-toast" class="hidden fixed bottom-5 right-5 z-50 w-80 rounded-2xl border border-white/[0.1] bg-[#171922] p-4 shadow-2xl">
      <div class="flex items-center gap-3">
        <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-cyan-400/10 text-cyan-300">
          <i data-lucide="upload-cloud" class="w-4 h-4"></i>
        </div>
        <div class="min-w-0 flex-1">
          <div id="upload-toast-name" class="truncate text-[12px] font-medium text-white">Uploading...</div>
          <div class="text-[10px] text-slate-500">Sending to Backblaze Vault</div>
        </div>
        <span id="upload-toast-pct" class="text-[11px] text-cyan-300">0%</span>
      </div>
      <div class="mt-3 h-1.5 overflow-hidden rounded-full bg-white/[0.08]">
        <div id="upload-progress-fill" class="h-full w-0 bg-gradient-to-r from-indigo-400 to-cyan-300 transition-all duration-200"></div>
      </div>
    </div>
  </div>

  <script>
    const BACKEND_API_URL = "https://cloudvault-backend-utgb.onrender.com";
    const SUPABASE_URL = "https://YOUR_SUPABASE_PROJECT_ID.supabase.co"; 
    const SUPABASE_ANON_KEY = "YOUR_SUPABASE_ANON_KEY"; 

    const supabaseClient = (window.supabase && !SUPABASE_URL.includes("YOUR_SUPABASE")) 
      ? window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY) 
      : null;

    let liveFiles = JSON.parse(localStorage.getItem('cloudvault_files') || '[]');
    let currentFilter = 'All types';

    async function loadFiles() {
      if (supabaseClient) {
        const { data, error } = await supabaseClient
          .from('files')
          .select('*')
          .order('created_at', { ascending: false });

        if (!error && data) {
          liveFiles = data;
        }
      }
      updateStorageAnalytics(liveFiles);
      renderFiles();
    }

    function updateStorageAnalytics(files) {
      const totalBytes = files.reduce((acc, f) => acc + (f.bytes || 0), 0);
      const quotaBytes = 10 * 1024 * 1024 * 1024;
      const usedPct = Math.min(100, ((totalBytes / quotaBytes) * 100)).toFixed(1);
      const usedGB = (totalBytes / (1024 * 1024 * 1024)).toFixed(2);
      const usedMB = (totalBytes / (1024 * 1024)).toFixed(1);

      const offset = 106.8 - (106.8 * (usedPct / 100));
      document.getElementById('storage-ring-circle').style.strokeDashoffset = offset;
      document.getElementById('storage-pct-label').innerText = `${usedPct}%`;
      document.getElementById('storage-used-gb').innerText = usedGB;
      document.getElementById('storage-bytes-count').innerText = `${usedMB} MB active`;
      document.getElementById('stat-total-files').innerHTML = `${files.length} <span class="text-sm font-normal text-slate-500">files indexed</span>`;

      const mediaBytes = files.filter(f => ['video', 'audio', 'image'].includes(f.kind)).reduce((acc, f) => acc + (f.bytes || 0), 0);
      const docBytes = files.filter(f => f.kind === 'document').reduce((acc, f) => acc + (f.bytes || 0), 0);

      document.getElementById('stat-media-size').innerText = `${(mediaBytes / (1024 * 1024)).toFixed(1)} MB`;
      document.getElementById('stat-docs-size').innerText = `${(docBytes / (1024 * 1024)).toFixed(1)} MB`;
    }

    async function handleRealUpload(file) {
      const toast = document.getElementById('upload-toast');
      const toastName = document.getElementById('upload-toast-name');
      const toastPct = document.getElementById('upload-toast-pct');
      const progressFill = document.getElementById('upload-progress-fill');

      toast.classList.remove('hidden');
      toastName.innerText = file.name;
      toastPct.innerText = '0%';
      progressFill.style.width = '0%';

      try {
        const formData = new FormData();
        formData.append('file', file);

        const uploadResult = await new Promise((resolve, reject) => {
          const xhr = new XMLHttpRequest();
          xhr.open('POST', `${BACKEND_API_URL}/api/upload`, true);

          xhr.upload.onprogress = (e) => {
            if (e.lengthComputable) {
              const pct = Math.round((e.loaded / e.total) * 100);
              toastPct.innerText = `${pct}%`;
              progressFill.style.width = `${pct}%`;
            }
          };

          xhr.onload = () => {
            if (xhr.status >= 200 && xhr.status < 300) {
              resolve(JSON.parse(xhr.responseText));
            } else {
              reject(new Error(`Upload failed with status ${xhr.status}`));
            }
          };
          xhr.onerror = () => reject(new Error('Network error during upload'));
          xhr.send(formData);
        });

        let kind = 'document';
        if (file.type.startsWith('video')) kind = 'video';
        else if (file.type.startsWith('image')) kind = 'image';
        else if (file.type.startsWith('audio')) kind = 'audio';

        const formattedSize = file.size > 1024 * 1024 ? `${(file.size / (1024 * 1024)).toFixed(1)} MB` : `${(file.size / 1024).toFixed(1)} KB`;

        const newFileRecord = {
          name: file.name,
          kind: kind,
          size: formattedSize,
          bytes: file.size,
          key: uploadResult.fileKey,
          folder: 'Projects',
          created_at: new Date().toISOString()
        };

        if (supabaseClient) {
          await supabaseClient.from('files').insert([newFileRecord]);
        }

        // Local storage backup persistence
        liveFiles.unshift(newFileRecord);
        localStorage.setItem('cloudvault_files', JSON.stringify(liveFiles));

        updateStorageAnalytics(liveFiles);
        renderFiles();

      } catch (err) {
        alert("Upload error: " + err.message);
      } finally {
        setTimeout(() => toast.classList.add('hidden'), 2000);
      }
    }

    function renderFiles() {
      const container = document.getElementById('file-container');
      container.innerHTML = '';

      const visible = liveFiles.filter(f => {
        if (currentFilter === 'All types') return true;
        return f.kind === currentFilter;
      });

      visible.forEach(file => {
        const item = document.createElement('div');
        item.className = 'group text-left rounded-2xl border border-white/[0.08] bg-white/[0.025] p-3.5 hover:border-indigo-300/25 hover:bg-white/[0.045] transition-all cursor-pointer';
        
        let icon = 'file-text';
        if (file.kind === 'video') icon = 'video';
        if (file.kind === 'image') icon = 'image';
        if (file.kind === 'audio') icon = 'music';

        item.innerHTML = `
          <div class="relative mb-3 flex h-32 w-full items-center justify-center overflow-hidden rounded-xl bg-gradient-to-br from-white/[0.06] to-transparent">
            <i data-lucide="${icon}" class="w-8 h-8 text-indigo-400"></i>
          </div>
          <div class="truncate text-[12px] font-medium text-slate-200 group-hover:text-white">${file.name}</div>
          <div class="mt-1.5 flex items-center justify-between text-[10px] text-slate-600">
            <span>${file.size}</span>
            <span>${new Date(file.created_at).toLocaleDateString()}</span>
          </div>
        `;

        item.addEventListener('click', () => openPreview(file));
        container.appendChild(item);
      });

      lucide.createIcons();
    }

    function openPreview(file) {
      document.getElementById('dashboard-view').classList.add('hidden');
      document.getElementById('player-view').classList.remove('hidden');
      document.getElementById('player-file-name').innerText = file.name;

      const videoPlayer = document.getElementById('vault-video-player');
      const audioPlayer = document.getElementById('vault-audio-player');
      const imgPreview = document.getElementById('vault-image-preview');
      const docPreview = document.getElementById('vault-doc-preview');
      const docLink = document.getElementById('vault-doc-link');
      const downloadBtn = document.getElementById('btn-download-file');

      videoPlayer.classList.add('hidden');
      audioPlayer.classList.add('hidden');
      imgPreview.classList.add('hidden');
      docPreview.classList.add('hidden');

      const streamUrl = `${BACKEND_API_URL}/api/stream/${encodeURIComponent(file.key)}`;
      downloadBtn.href = streamUrl;

      if (file.kind === 'video') {
        videoPlayer.classList.remove('hidden');
        videoPlayer.src = streamUrl;
        videoPlayer.play();
      } else if (file.kind === 'image') {
        imgPreview.classList.remove('hidden');
        imgPreview.src = streamUrl;
      } else if (file.kind === 'audio') {
        audioPlayer.classList.remove('hidden');
        audioPlayer.src = streamUrl;
        audioPlayer.play();
      } else {
        docPreview.classList.remove('hidden');
        docLink.href = streamUrl;
      }
    }

    document.getElementById('btn-back').addEventListener('click', () => {
      document.getElementById('vault-video-player').pause();
      document.getElementById('vault-audio-player').pause();
      document.getElementById('player-view').classList.add('hidden');
      document.getElementById('dashboard-view').classList.remove('hidden');
    });

    document.getElementById('btn-upload').addEventListener('click', () => document.getElementById('file-input').click());
    document.getElementById('file-input').addEventListener('change', (e) => {
      if (e.target.files.length) handleRealUpload(e.target.files[0]);
    });

    document.querySelectorAll('.filter-tab').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.filter-tab').forEach(b => {
          b.className = 'filter-tab whitespace-nowrap rounded-full border border-white/[0.07] px-3 py-1.5 text-[11px] text-slate-600 hover:border-white/[0.14] hover:text-slate-300';
        });
        btn.className = 'filter-tab whitespace-nowrap rounded-full border px-3 py-1.5 text-[11px] border-indigo-400/30 bg-indigo-400/10 text-indigo-200';
        currentFilter = btn.getAttribute('data-filter');
        renderFiles();
      });
    });

    loadFiles();
    lucide.createIcons();
  </script>
</body>
</html>
